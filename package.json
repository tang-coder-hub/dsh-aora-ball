{
  "name": "dsh-aora-ball",
  "version": "0.3.0",
  "author": "tang-coder-hub <293740307+tang-coder-hub@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tang-coder-hub/dsh-aora-ball.git"
  },
  "homepage": "https://github.com/tang-coder-hub/dsh-aora-ball",
  "license": "MIT",
  "description": "DSH 界面内表情球 —— Emotion Ball 引擎 + 会话状态驱动（右下角悬浮，随思考/工具/出错/完成变表情）",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.2 <0.3.0",
      "node": ">=20.18",
      "profiles": [
        "desktop"
      ]
    }
  },
  "engines": {
    "node": ">=20.18"
  }
}
